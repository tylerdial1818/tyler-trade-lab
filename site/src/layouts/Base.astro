---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'A public lab notebook on prediction markets, data and causal inference.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname;
const nav = [
  { href: `${base}/method/`, label: 'Method' },
  { href: `${base}/essays/`, label: 'Essays' },
  { href: `${base}/experiments/`, label: 'Experiments' },
  { href: `${base}/about/`, label: 'About' },
];
const pageTitle = title === 'Tyler Trade Labs' ? title : `${title} | Tyler Trade Labs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="page">
      <header class="site">
        <a class="name" href={`${base}/`}>Tyler Trade Labs</a>
        <nav aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="site">
        Tyler Dial · <a href="https://tylerdial.dev">tylerdial.dev</a> · Dialed Intelligence
      </footer>
    </div>
  </body>
</html>
